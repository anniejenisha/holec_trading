{
  "doctype": "DocType",
  "name": "Buy Ticket",
  "module": "Holec Trading",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "autoname": "naming_series:",
  "naming_rule": "By \"Naming Series\" field",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "Series",
      "fieldtype": "Select",
      "options": "TCK-.YYMM.-.####",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nOffered\nTicket\nConverted\nCancelled",
      "default": "Draft",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "read_only": 1,
      "description": "Offered = created by a Supplier, awaiting Purchase User confirmation. Ticket = confirmed, entered the Lot lifecycle."
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "supplier",
      "label": "Supplier",
      "fieldtype": "Link",
      "options": "Supplier",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Must be an Approved/Active Supplier record."
    },
    {
      "fieldname": "sec_break_trade",
      "fieldtype": "Section Break",
      "label": "Trade Terms"
    },
    {
      "fieldname": "commodity",
      "label": "Commodity",
      "fieldtype": "Select",
      "options": "Maize",
      "default": "Maize",
      "reqd": 1
    },
    {
      "fieldname": "region",
      "label": "Region",
      "fieldtype": "Link",
      "options": "Origin County",
      "read_only": 1,
      "fetch_from": "supplier.county",
      "description": "Fetched from the Supplier record - not entered per ticket."
    },
    {
      "fieldname": "quantity_kg",
      "label": "Quantity Offered (kg)",
      "fieldtype": "Float",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "negotiated_price",
      "label": "Price Offered (KES/kg)",
      "fieldtype": "Currency",
      "reqd": 1,
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1, "write": 1, "create": 1, "delete": 1
    },
    {
      "role": "Trading Officer",
      "read": 1, "write": 1, "create": 1
    },
    {
      "role": "Supplier",
      "read": 1, "write": 1, "create": 1,
      "if_owner": 1
    }
  ]
}
